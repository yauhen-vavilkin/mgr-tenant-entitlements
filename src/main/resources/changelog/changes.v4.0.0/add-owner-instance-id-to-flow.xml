<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

  <!-- Existing flows remain compatible and are intentionally left without an owner. -->
  <changeSet id="add-owner-instance-id-to-flow" author="folio">
    <addColumn tableName="flow">
      <column name="owner_instance_id" type="UUID"/>
    </addColumn>
  </changeSet>

  <changeSet id="add-fence-token-to-flow" author="folio">
    <addColumn tableName="flow">
      <column name="fence_token" type="BIGINT" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>

  <changeSet id="add-interrupted-flow-status" author="folio">
    <sql>ALTER TYPE entitlement_flow_status_type ADD VALUE 'INTERRUPTED' AFTER 'IN_PROGRESS';</sql>
  </changeSet>

</databaseChangeLog>
