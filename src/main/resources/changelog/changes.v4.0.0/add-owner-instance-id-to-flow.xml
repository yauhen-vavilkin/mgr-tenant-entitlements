<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

  <!-- Nullable, no back-fill: NULL owner marks flows created before ownership tracking. -->
  <changeSet id="add-owner-instance-id-to-flow" author="mte">
    <addColumn tableName="flow">
      <column name="owner_instance_id" type="VARCHAR(255)"/>
    </addColumn>
  </changeSet>
</databaseChangeLog>
